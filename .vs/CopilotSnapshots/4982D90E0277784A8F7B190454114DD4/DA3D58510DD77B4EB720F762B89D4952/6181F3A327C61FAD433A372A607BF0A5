    private void StartAnimation()
    {
        if (_running) return;
        _running = true;
        _cts = new CancellationTokenSource();

        // run async loop without blocking UI thread
        var token = _cts.Token;
        Task.Run(async () => await AnimationLoopAsync(token), token);
    }

    private void StopAnimation()
    {
        if (!_running) return;
        _cts?.Cancel();
        _cts?.Dispose();
        _cts = null;
        _running = false;
    }

    private async Task AnimationLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                var topOffset = _menuStrip?.Height ?? 0;
                var bottomOffset = _statusLabel?.Height ?? 0;

                int width = Math.Max(1, ClientSize.Width);
                int height = Math.Max(1, ClientSize.Height - topOffset - bottomOffset);

                float sx = width / 280f;
                float sy = height / 160f;

                int A = (int)(_rnd.NextDouble() * 279);
                int B = (int)(_rnd.NextDouble() * 159);
                int step = _rnd.Next(2, 5);

                if (_statusLabel != null)
                {
                    try { BeginInvoke((Action)(() => _statusLabel.Text = $"STEPPING BY {step}\nPRESS 'ESC' TO STOP")); }
                    catch { }
                }

                var bmp = new Bitmap(width, height);
                // capture current delays so user changes apply to next pattern
                int segmentDelay = _segmentDelayMs;
                int postPause = _postPatternPauseMs;
                using (var g = Graphics.FromImage(bmp))
                {
                    g.Clear(_bgColor);
                    g.SmoothingMode = System.Drawing.Drawing2D.SmoothingMode.None;

                    // publish the bitmap reference once so OnPaint can draw it safely under lock
                    lock (_bitmapLock)
                    {
                        _bitmap?.Dispose();
                        _bitmap = bmp;
                    }

                    // draw X-based lines

                for (int x = 0; x <= 278; x += step)
                    {
                        for (int s = 0; s <= 1; s++)
                        {
                            if (token.IsCancellationRequested) break;

                            var color = s == 0 ? _fgColor : _bgColor;
                            using var pen = new Pen(color);

                            var x1 = (int)((x + s) * sx);
                            var y1 = 0;
                            var cx = (int)(A * sx);
                            var cy = (int)(B * sy);

                            lock (_bitmapLock)
                            {
                                g.DrawLine(pen, x1, y1, cx, cy);
                            }

                            try { BeginInvoke((Action)Invalidate); } catch { }
                            await Task.Delay(segmentDelay, token).ConfigureAwait(false);

                            if (token.IsCancellationRequested) break;

                            var x2 = (int)((279 - x - s) * sx);
                            var y2 = height - 1;

                            lock (_bitmapLock)
                            {
                                g.DrawLine(pen, cx, cy, x2, y2);
                            }

                            try { BeginInvoke((Action)Invalidate); } catch { }
                            await Task.Delay(segmentDelay, token).ConfigureAwait(false);
                        }
                        if (token.IsCancellationRequested) break;
                    }

                    // draw Y-based lines
                    for (int y = 0; y <= 158; y += step)
                    {
                        for (int s = 0; s <= 1; s++)
                        {
                            if (token.IsCancellationRequested) break;

                            var color = s == 0 ? _fgColor : _bgColor;
                            using var pen = new Pen(color);

                            var x1 = width - 1;
                            var y1 = (int)((y + s) * sy);
                            var cx = (int)(A * sx);
                            var cy = (int)(B * sy);

                            lock (_bitmapLock)
                            {
                                g.DrawLine(pen, x1, y1, cx, cy);
                            }

                            try { BeginInvoke((Action)Invalidate); } catch { }
                            await Task.Delay(segmentDelay, token).ConfigureAwait(false);

                            if (token.IsCancellationRequested) break;

                            var x2 = 0;
                            var y2 = (int)((159 - y - s) * sy);

                            lock (_bitmapLock)
                            {
                                g.DrawLine(pen, cx, cy, x2, y2);
                            }

                            try { BeginInvoke((Action)Invalidate); } catch { }
                            await Task.Delay(segmentDelay, token).ConfigureAwait(false);
                        }
                        if (token.IsCancellationRequested) break;
                    }
                }

                // short pause after full pattern
                try { await Task.Delay(postPause, token).ConfigureAwait(false); } catch (OperationCanceledException) { }
            }
        }
        catch (OperationCanceledException) { }
        finally
        {
            _running = false;
        }
    }

    private void ReplaceBitmap(Bitmap newBmp)
    {
        // invoked from background thread
        try
        {
            Invoke((Action)(() =>
            {
                _bitmap?.Dispose();
                _bitmap = newBmp;
                Invalidate();
            }));
        }
        catch (ObjectDisposedException)
        {
            // form is closing
            newBmp.Dispose();
        }
    }
